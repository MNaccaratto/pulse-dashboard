# --- Access control (required in production) ---
DASHBOARD_USER=choose-a-username
DASHBOARD_PASSWORD=choose-a-long-random-password

# --- General ---
DASHBOARD_TIMEZONE=America/New_York
# Set to true to show demo data and skip real API calls
USE_MOCK_DATA=false

# --- Notion ---
NOTION_TOKEN=secret_xxx
# Format: Label=databaseId,Label2=databaseId2
NOTION_DATABASE_IDS=Tasks=your_database_id
NOTION_STATUS_PROPERTY=Status
NOTION_DUE_PROPERTY=Due Date
# Comma-separated status names that count as finished
NOTION_DONE_STATUSES=done,complete,completed
# Optional: also filter out rows where this checkbox property is checked
# NOTION_DONE_CHECKBOX_PROPERTY=Completed

# --- Google Calendar (service account) ---
# Recommended: base64 of the downloaded service-account JSON  ->  base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternative to the line above:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Format: Label=calendarId,Label2=calendarId2 (share each calendar with the service account email)
GOOGLE_CALENDAR_IDS=Personal=you@example.com